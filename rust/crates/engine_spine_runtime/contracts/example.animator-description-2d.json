    "attack":{"clip":"attack","layer":"upper","playback":"once","speedPermille":1000,"mixInSeconds":0.08,"fadeOutSeconds":0.12,"onComplete":"fadeOutLayer"}
  },
  "rules": [{"all":[{"triggered":"attack"}],"play":"attack"}],
  "sockets": {"muzzle":{"bone":"upper","offset":[0,0,0]}}
}
